  <diagram id="laravel-erd" name="Infrastruktur Laravel">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="infra-title" value="&lt;b&gt;ERD Solopos Membership — Tabel Infrastruktur Laravel&lt;/b&gt;&lt;br&gt;Tabel framework tanpa relasi FK eksplisit pada migration" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="infra-note" value="Tabel &lt;b&gt;sessions&lt;/b&gt; mempunyai kolom user_id nullable dan index, tetapi migration tidak mendefinisikan foreign key. &lt;b&gt;personal_access_tokens&lt;/b&gt; memakai relasi polymorphic (tokenable_type + tokenable_id), bukan foreign key biasa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6A64F;align=left;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="900" height="90" as="geometry" />
        </mxCell>
        <mxCell id="password-reset-tokens" value="&lt;b&gt;password_reset_tokens&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; email : VARCHAR(255)&lt;br&gt;token : VARCHAR(255)&lt;br&gt;created_at : TIMESTAMP NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sessions" value="&lt;b&gt;sessions&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : VARCHAR(255)&lt;br&gt;user_id : BIGINT UNSIGNED NULL (INDEX)&lt;br&gt;ip_address : VARCHAR(45) NULL&lt;br&gt;user_agent : TEXT NULL&lt;br&gt;payload : LONGTEXT&lt;br&gt;last_activity : INT (INDEX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="280" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="personal-access-tokens" value="&lt;b&gt;personal_access_tokens&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED&lt;br&gt;tokenable_type : VARCHAR(255)&lt;br&gt;tokenable_id : BIGINT UNSIGNED&lt;br&gt;name : TEXT&lt;br&gt;token : VARCHAR(64) UNIQUE&lt;br&gt;abilities : TEXT NULL&lt;br&gt;last_used_at : TIMESTAMP NULL&lt;br&gt;expires_at : TIMESTAMP NULL (INDEX)&lt;br&gt;created_at : TIMESTAMP NULL&lt;br&gt;updated_at : TIMESTAMP NULL&lt;br&gt;&lt;i&gt;INDEX (tokenable_type, tokenable_id)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="270" width="330" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;cache&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; key : VARCHAR(255)&lt;br&gt;value : MEDIUMTEXT&lt;br&gt;expiration : BIGINT (INDEX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cache-locks" value="&lt;b&gt;cache_locks&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; key : VARCHAR(255)&lt;br&gt;owner : VARCHAR(255)&lt;br&gt;expiration : BIGINT (INDEX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="540" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="jobs" value="&lt;b&gt;jobs&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED&lt;br&gt;queue : VARCHAR(255) (INDEX)&lt;br&gt;payload : LONGTEXT&lt;br&gt;attempts : SMALLINT UNSIGNED&lt;br&gt;reserved_at : INT UNSIGNED NULL&lt;br&gt;available_at : INT UNSIGNED&lt;br&gt;created_at : INT UNSIGNED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="630" width="330" height="210" as="geometry" />
        </mxCell>
        <mxCell id="job-batches" value="&lt;b&gt;job_batches&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : VARCHAR(255)&lt;br&gt;name : VARCHAR(255)&lt;br&gt;total_jobs : INT&lt;br&gt;pending_jobs : INT&lt;br&gt;failed_jobs : INT&lt;br&gt;failed_job_ids : LONGTEXT&lt;br&gt;options : MEDIUMTEXT NULL&lt;br&gt;cancelled_at : INT NULL&lt;br&gt;created_at : INT&lt;br&gt;finished_at : INT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="270" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="failed-jobs" value="&lt;b&gt;failed_jobs&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED&lt;br&gt;uuid : VARCHAR(255) UNIQUE&lt;br&gt;connection : VARCHAR(255)&lt;br&gt;queue : VARCHAR(255)&lt;br&gt;payload : LONGTEXT&lt;br&gt;exception : LONGTEXT&lt;br&gt;failed_at : TIMESTAMP&lt;br&gt;&lt;i&gt;INDEX (connection, queue, failed_at)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
